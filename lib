                    BorderSizePixel = 0,
                    BackgroundColor3 = Color
                }):AddToTheme({BackgroundColor3 = LinerTheme})
        
                Notification.Items = Items
            end
        
            local FadeNotification = function(Transparency)
                local NotificationObject = SafeWrapperInstance(Items["Notification"])
                if not NotificationObject then
                    return
                end

                Library:Tween({BackgroundTransparency = Transparency}, NotifTweenInfo, NotificationObject)
        
                for _, Value in NotificationObject:GetDescendants() do
                    if Value:IsA("TextLabel") then
                        Library:Tween({TextTransparency = Transparency}, NotifTweenInfo, Value)
                    elseif Value:IsA("Frame") then
                        Library:Tween({BackgroundTransparency = Transparency}, NotifTweenInfo, Value)
                    elseif Value:IsA("UIStroke") then
                        Library:Tween({Transparency = Transparency}, NotifTweenInfo, Value)
                    end
                end
            end
        
            table.insert(Library.Notifications, 1, Notification)
        
            task.wait()
        
            local NotificationObject = SafeWrapperInstance(Items["Notification"])
            if not NotificationObject then
                local NotificationIndex = table.find(Library.Notifications, Notification)
                if NotificationIndex then
                    table.remove(Library.Notifications, NotificationIndex)
                end
                return Notification
            end

            local Width = NotificationObject.AbsoluteSize.X
            local Height = NotificationObject.AbsoluteSize.Y
        
            NotificationObject.Size = UDim2.new(0, Width, 0, Height)
            NotificationObject.AutomaticSize = Enum.AutomaticSize.None
            NotificationObject.BackgroundTransparency = 1
        
            for _, Value in NotificationObject:GetDescendants() do
                if Value:IsA("TextLabel") then
                    Value.TextTransparency = 1
                elseif Value:IsA("Frame") then
                    Value.BackgroundTransparency = 1
                elseif Value:IsA("UIStroke") then
                    Value.Transparency = 1
                end
            end
        
            UpdatePositions()
            FadeNotification(0)
        
            Library:Tween({Size = UDim2.new(0, 0, 0, 1)}, TweenInfo.new(Duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), SafeWrapperInstance(Items["DurationLiner"]))

            local function RemoveNotification()
                if Notification.Removing then
                    return
                end
                Notification.Removing = true
        
                if not Library then
                    return
                end

                local NotificationIndex = table.find(Library.Notifications, Notification)
                if NotificationIndex then
                    table.remove(Library.Notifications, NotificationIndex)
                end
        
                local Position = Library.NotificationPosition
                local IsRight = Position == "Right" or Position == "Right Bottom"
                local IsBottom = Position == "Left Bottom" or Position == "Right Bottom"
                local ViewportSize = Vector2.new(1920, 1080)
                pcall(function()
                    local CurrentCamera = workspace.CurrentCamera
                    if CurrentCamera then
                        ViewportSize = CurrentCamera.ViewportSize
                    end
                end)

                local CurrentObject = SafeWrapperInstance(Items["Notification"])
                if not CurrentObject then
                    UpdatePositions()
                    return
                end

                local targetX = IsRight and (ViewportSize.X + 260) or -(Width + Padding + 20)
                local targetY = IsBottom and (ViewportSize.Y + 260) or CurrentObject.Position.Y.Offset
                Library:Tween({
                    Position = UDim2.new(0, targetX, 0, targetY)
                }, NotifTweenInfo, CurrentObject)

                FadeNotification(1)
        
                task.delay(NotifTweenInfo.Time, function()
                    pcall(function()
                        local Object = SafeWrapperInstance(Items["Notification"])
                        if Object then
                            Object:Destroy()
                        end
                    end)
                    UpdatePositions()
                end)
            end

            Notification.Remove = RemoveNotification
            task.delay(Duration, RemoveNotification)
        
            return Notification
        end
        
