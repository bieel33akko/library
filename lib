    local function getEnumMember(enumType, name)
        local ok, enumItem = pcall(function()
            return enumType[name]
        end)
        return ok and enumItem or nil
    end

    local function resolveKey(value)
        if typeof(value) == "EnumItem" then
            return value
        end

        if type(value) ~= "string" or value == "" or value == "none" then
            return nil
        end

        local keyName = value
            :gsub("^Enum%.KeyCode%.", "")
            :gsub("^Enum%.UserInputType%.", "")

        if keyName == "" then
            return nil
        end

        return getEnumMember(Enum.KeyCode, keyName)
            or getEnumMember(Enum.UserInputType, keyName)
    end

    local function matchesInput(input)
        return Keybind.Key ~= ""
            and (input.KeyCode.Name == Keybind.Key or input.UserInputType.Name == Keybind.Key)
    end

    function Keybind:Set(value)
        local mode
        local key = value
        local RestoreToggled = false

        if type(value) == "table" then
            mode = value.Mode
            key = value.Key
            if value.Toggled ~= nil then
                Keybind.Toggled = value.Toggled == true or value.Toggled == 1 or value.Toggled == "true"
                RestoreToggled = true
            end
        elseif table.find({"Toggle", "Hold", "Always"}, value) then
            mode = value
            key = nil
        end

        if mode and table.find({"Toggle", "Hold", "Always"}, mode) then
            Keybind.Mode = mode
        end

        
        if not RestoreToggled and Keybind.Mode == "Always" then
            Keybind.Toggled = true
            RestoreToggled = true
        end

        local enumItem = resolveKey(key)
        if enumItem then
            Keybind.Key = enumItem.Name
            Keybind.Value = enumItem.Name
            local KeyButtonObject = SafeWrapperInstance(Items["KeyButton"])
            if KeyButtonObject then
                KeyButtonObject.Text = enumItem.Name:lower()
            end
        elseif key ~= nil then
            Keybind.Key = ""
            Keybind.Value = ""
            local KeyButtonObject = SafeWrapperInstance(Items["KeyButton"])
            if KeyButtonObject then
                KeyButtonObject.Text = "none"
            end
        end

        Keybind:SetMode()
        if RestoreToggled and Data.Callback then
            Library:SafeCall(Data.Callback, Keybind.Toggled)
        end
        Update()
        Keybind.Picking = false
    end

    Items["KeyButton"]:Connect("MouseButton1Click", function()
        Keybind.Picking = true 

        local KeyButtonObject = SafeWrapperInstance(Items["KeyButton"])
        if KeyButtonObject then
            KeyButtonObject.Text = ". . ."
        end

        local InputBegan
        InputBegan = UserInputService.InputBegan:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.Keyboard then 
                Keybind:Set(Input.KeyCode)
            else
                Keybind:Set(Input.UserInputType)
            end

            InputBegan:Disconnect()
            InputBegan = nil
        end)
    end)

    Library:Connect(UserInputService.InputBegan, function(Input, GPE)
        if not GPE
            and not Keybind.Picking
            and not UserInputService:GetFocusedTextBox()
            and matchesInput(Input)
        then
            if Keybind.Mode == "Toggle" then
                Keybind:Press()
            elseif Keybind.Mode == "Hold" or Keybind.Mode == "Always" then
                Keybind:Press(true)
            end
        end

        if Input.UserInputType == Enum.UserInputType.MouseButton1 and Keybind.IsOpen then 
            if not Items["KeybindWindow"]:IsMouseOverFrame() and not ModeDropdown.Items.OptionHolder:IsMouseOverFrame() then
                Keybind:SetOpen(false)
            end
        end
    end)

    Library:Connect(UserInputService.InputEnded, function(Input, GPE)
        if not GPE and matchesInput(Input) and Keybind.Mode == "Hold" then
            Keybind:Press(false)
        end
    end)

    Items["KeyButton"]:Connect("MouseButton2Down", function()
        Keybind:SetOpen(not Keybind.IsOpen)
    end)

    if Data.Default then
        
        local default = Data.Default
        if type(default) == "string" and not default:find("Enum") then
            local ok, enum = pcall(function() return Enum.KeyCode[default] end)
            if ok and enum then
                default = enum
            else
                local ok2, enum2 = pcall(function() return Enum.UserInputType[default] end)
                if ok2 and enum2 then
                    default = enum2
                end
            end
        end
        Keybind:Set({
            Mode = Data.Mode or "Toggle",
            Key = default,
        })
    end

    SetFlags[Keybind.Flag] = function(Value)
        Keybind:Set(Value)
    end

    return Keybind, Items 
end

