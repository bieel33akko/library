    local function SafeWrapperInstance(wrapper)
        
        
        
        if typeof(wrapper) == "Instance" then
            return wrapper
        end

        if type(wrapper) ~= "table" then
            return nil
        end

        local ok, object = pcall(rawget, wrapper, "Instance")
        if not ok or typeof(object) ~= "Instance" then
            return nil
        end
        return object
    end

local function SafeProperty(object, property, value)
    if typeof(object) ~= "Instance" then
        return false
    end
    return pcall(function()
        object[property] = value
    end)
end

