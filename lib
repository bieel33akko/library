    local SaveManager = {} do
        SaveManager.Folder = Library.Directory or "AkkoMenu"
        SaveManager.Ignore = {}
        
        function SaveManager:SetIgnoreIndexes(list)
            for _, key in next, list do
                self.Ignore[key] = true
            end
        end

        function SaveManager:RefreshConfigList()
            local list = listfiles(Library.Directory .. Library.Folders.Configs)
            local out = {}
            for i = 1, #list do
                local file = list[i]
                if file:sub(-5) == ".json" then
                    local configName = file:match("[^/\\]+%.json$")
                    if configName then
                        table.insert(out, configName:sub(1, -6))
                    end
                end
            end
            return out
        end

        function SaveManager:Save(name)
            if (not name) then return false, "no config file is selected" end
            local fullPath = Library.Directory .. Library.Folders.Configs .. "/" .. name .. ".json"
            
            local data = { 
                objects = {},
                Theme = Library.SelectedTheme,
                MenuScale = Library.MenuScale,
                Positions = {}
            }

            
            pcall(function()
                local wm = Library.WatermarkObject
                if wm and wm.Items and wm.Items["Watermark"] and wm.Items["Watermark"].Instance then
                    local pos = wm.Items["Watermark"].Instance.Position
                    data.Positions.Watermark = { pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset }
                end
            end)

            
            pcall(function()
                local kl = Library.KeyList
                if kl and kl.Items and kl.Items["KeybindList"] and kl.Items["KeybindList"].Instance then
                    local pos = kl.Items["KeybindList"].Instance.Position
                    data.Positions.KeybindList = { pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset }
                    local size = kl.Items["KeybindList"].Instance.Size
                    data.Positions.KeybindListSize = { size.X.Scale, size.X.Offset, size.Y.Scale, size.Y.Offset }
                end
            end)

            for idx, val in next, Library.Flags do
                if self.Ignore[idx] then continue end
                
                
                if type(val) == "table" then
                    if val.Color then
                        table.insert(data.objects, { idx = idx, value = { Color = "#" .. val.HexValue, Alpha = val.Alpha } })
                    elseif val.Key then
                        table.insert(data.objects, { idx = idx, value = { Key = tostring(val.Key), Mode = val.Mode, Toggled = val.Toggled } })
                    else
                        table.insert(data.objects, { idx = idx, value = val })
                    end
                else
                    table.insert(data.objects, { idx = idx, value = val })
                end
            end

            local success, encoded = pcall(HttpService.JSONEncode, HttpService, data)
            if not success then return false, "failed to encode data" end

            local writeSuccess = pcall(writefile, fullPath, encoded)
            if not writeSuccess then return false, "failed to write config file" end
            return true
        end

        function SaveManager:Load(name)
            if (not name) then return false, "no config file is selected" end
            local file = Library.Directory .. Library.Folders.Configs .. "/" .. name .. ".json"
            if not isfile(file) then return false, "invalid file" end

            local readSuccess, contents = pcall(readfile, file)
            if not readSuccess or type(contents) ~= "string" or contents == "" then
                return false, "read error"
            end

            local success, decoded = pcall(HttpService.JSONDecode, HttpService, contents)
            if not success then return false, "decode error" end
            if type(decoded) ~= "table" then return false, "invalid config data" end

            
            if type(decoded.objects) == "table" then
                for _, option in next, decoded.objects do
                    if type(option) == "table" and option.idx and Library.SetFlags[option.idx] then
                        local setter = Library.SetFlags[option.idx]
                        local val = option.value
                        if type(val) == "table" and val.Color then
                            pcall(setter, Color3.fromHex(val.Color), val.Alpha)
                        else
                            pcall(setter, val)
                        end
                    end
                end
            end

            
            if decoded.Theme and Themes[decoded.Theme] then
                Library.SelectedTheme = decoded.Theme
                Library.Theme = Themes[decoded.Theme]
                for ThemeKey, ColorValue in pairs(Library.Theme) do
                    Library:ChangeTheme(ThemeKey, ColorValue)
                end
            end

            
            if decoded.MenuScale then
                Library.MenuScale = decoded.MenuScale
                if Library.MenuScaleObject then
                    Library.MenuScaleObject.Scale = decoded.MenuScale
                end
            end

            
            if decoded.Positions then
                pcall(function()
                    if decoded.Positions.Watermark then
                        local wm = Library.WatermarkObject
                        if wm and wm.Items and wm.Items["Watermark"] and wm.Items["Watermark"].Instance then
                            local p = decoded.Positions.Watermark
                            wm.Items["Watermark"].Instance.Position = UDim2.new(p[1], p[2], p[3], p[4])
                        end
                    end
                end)
                pcall(function()
                    if decoded.Positions.KeybindList then
                        local kl = Library.KeyList
                        if kl and kl.Items and kl.Items["KeybindList"] and kl.Items["KeybindList"].Instance then
                            local p = decoded.Positions.KeybindList
                            kl.Items["KeybindList"].Instance.Position = UDim2.new(p[1], p[2], p[3], p[4])
                        end
                    end
                end)
                pcall(function()
                    if decoded.Positions.KeybindListSize then
                        local kl = Library.KeyList
                        if kl and type(kl.SetSize) == "function" then
                            local s = decoded.Positions.KeybindListSize
                            kl:SetSize(s[2], s[4])
                        end
                    end
                end)
            end

            return true
        end

        function SaveManager:BuildConfigSection(tab)
            local section = tab:Section({Name = "Configuration", Side = 3})
            
            section:Textbox({
                Name = "Config name",
                Flag = "SaveManager_ConfigName",
                Placeholder = "Config name"
            })

            local ConfigList = section:Dropdown({
                Name = "Config list",
                Flag = "SaveManager_ConfigList",
                Items = self:RefreshConfigList(),
                AllowNull = true
            })

            section:Button({
                Name = "Create config",
                Callback = function()
                    local name = Library.Flags.SaveManager_ConfigName
                    if not name or name:gsub(" ", "") == "" then 
                        return Library:Notification("Invalid config name (empty)", 2)
                    end

                    local success, err = self:Save(name)
                    if not success then
                        return Library:Notification("Failed to save config: " .. tostring(err))
                    end

                    Library:Notification(string.format("Created config %q", name))
                    ConfigList:Refresh(self:RefreshConfigList())
                end
            })

            section:Button({
                Name = "Load config",
                Callback = function()
                    local name = Library.Flags.SaveManager_ConfigList
                    local success, err = self:Load(name)
                    if not success then
                        return Library:Notification("Failed to load config: " .. tostring(err))
                    end
                    Library:Notification(string.format("Loaded config %q", name))
                end
            })

            section:Button({
                Name = "Overwrite config",
                Callback = function()
                    local name = Library.Flags.SaveManager_ConfigList
                    local success, err = self:Save(name)
                    if not success then
                        return Library:Notification("Failed to overwrite config: " .. tostring(err))
                    end
                    Library:Notification(string.format("Overwrote config %q", name))
                end
            })

            section:Button({
                Name = "Refresh list",
                Callback = function()
                    ConfigList:Refresh(self:RefreshConfigList())
                end
            })

            section:Button({
                Name = "Set as autoload",
                Callback = function()
                    local name = Library.Flags.SaveManager_ConfigList
                    if name then
                        writefile(Library.Directory .. "/autoload.json", HttpService:JSONEncode({Config = name}))
                        Library:Notification(string.format("Set %q to auto load", name))
                    end
                end
            })

            section:Button({
                Name = "Remove autoload",
                Callback = function()
                    local AutoloadPath = Library.Directory .. "/autoload.json"
                    if isfile(AutoloadPath) then
                        delfile(AutoloadPath)
                        Library:Notification("Removed autoload")
                    end
                end
            })

            section:Button({
                Name = "Delete config",
                Callback = function()
                    local name = Library.Flags.SaveManager_ConfigList
                    if name then
                        local file = Library.Directory .. Library.Folders.Configs .. "/" .. name .. ".json"
                        if isfile(file) then
                            delfile(file)
                            Library:Notification(string.format("Deleted config %q", name))
                            ConfigList:Refresh(self:RefreshConfigList())
                        end
                    end
                end
            })
            
            self:SetIgnoreIndexes({ "SaveManager_ConfigList", "SaveManager_ConfigName" })
        end
        
        function SaveManager:LoadAutoloadConfig()
            local AutoloadPath = Library.Directory .. "/autoload.json"
            if isfile(AutoloadPath) then
                local ReadOk, Manifest = pcall(readfile, AutoloadPath)
                if not ReadOk or type(Manifest) ~= "string" or Manifest == "" then return end
                local DecodeOk, Data = pcall(HttpService.JSONDecode, HttpService, Manifest)
                if DecodeOk and type(Data) == "table" and type(Data.Config) == "string" and Data.Config ~= "" then
                    task.spawn(function()
                        local success, err = self:Load(Data.Config)
                        if success then
                            Library:Notification("Auto loaded config: " .. Data.Config, 3)
                        end
                    end)
                end
            end
        end

        Library.SaveManager = SaveManager
    end

