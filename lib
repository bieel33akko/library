    Library.GetScreenScale = function(Self)
        local Scale = 1
    
        local holder = Library.Holder and SafeWrapperInstance(Library.Holder)
        if not holder then
            return 1
        end
        for _, Obj in holder:GetDescendants() do
            if Obj:IsA("UIScale") then
                Scale *= Obj.Scale
            end
        end
    
        return Scale
    end
    
