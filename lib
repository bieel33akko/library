        Library.Notification = function(Self, Name, Duration, Color)
            
            local NotifTweenInfo = GetNotifTweenInfo()
            Name = tostring(Name or "")
            Duration = math.max(0, tonumber(Duration) or 5)
            local UseThemeAccent = Color == nil
            Color = typeof(Color) == "Color3" and Color or Library.Theme["Accent"]
        
            local Notification = {
                Duration = Duration,
                Color = Color,
                UseThemeAccent = UseThemeAccent,
                Removing = false,
                Items = {}
            }
        
            local Padding = 8
            local Spacing = 8
        
            local function GetNotificationSize(NotificationData)
                local Size
                local Ok = pcall(function()
                    local Item = NotificationData
                        and NotificationData.Items
                        and NotificationData.Items["Notification"]
                    local Object = SafeWrapperInstance(Item)
                    Size = Object and Object.AbsoluteSize
                end)

                if not Ok or not Size then
                    return nil
                end

                return Size
            end

            local function UpdatePositions()
                local ViewportSize = Vector2.new(1920, 1080)
                pcall(function()
                    local CurrentCamera = workspace.CurrentCamera
                    if CurrentCamera then
                        ViewportSize = CurrentCamera.ViewportSize
                    end
                end)

                local InvalidNotifications = {}
                for Index, Value in Library.Notifications do
                    local Size = GetNotificationSize(Value)
                    local Item = Value
                        and Value.Items
                        and Value.Items["Notification"]
                    local NotificationObject = SafeWrapperInstance(Item)

                    if not Size or not NotificationObject then
                        table.insert(InvalidNotifications, Index)
                        continue
                    end

                    local Position = Library.NotificationPosition
                    local IsRight = Position == "Right" or Position == "Right Bottom"
                    local IsBottom = Position == "Left Bottom" or Position == "Right Bottom"
                    local X = IsRight and (ViewportSize.X - Padding) or Padding
                    local Y = IsBottom and (ViewportSize.Y - Padding - Size.Y) or (GuiInset + Padding + 5)

                    
                    
                    for i = 1, Index - 1 do
                        local PreviousSize = GetNotificationSize(Library.Notifications[i])
                        if PreviousSize then
                            Y += IsBottom and -(PreviousSize.Y + Spacing) or (PreviousSize.Y + Spacing)
                        end
                    end

