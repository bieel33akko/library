        local function IsEnabled(Value)
            return Value == true or Value == 1 or Value == "true"
        end

        local function GetDependencyController(Self, Params)
            local Requested = Params.dependent
            if Requested == nil then
                Requested = Params.Dependent
            end
            if Requested == nil then
                Requested = Params.Dependency
            end

            if Requested == false or Requested == 0 or Requested == "false" then
                return nil
            end

            if Requested == nil then
                return Self.DependencyToggle
            end

            if IsEnabled(Requested) then
                return Self.DependencyToggle
            end

            if type(Requested) == "table" and type(Requested.SetVisibility) == "function" then
                return Requested
            end

            return Self.DependencyToggle
        end

        local function BindDependentControl(Control, Self, Params)
            local Dependency = GetDependencyController(Self, Params)
            if not Dependency or Dependency == Control then
                return nil
            end

            Control.Dependency = Dependency
            Dependency.Dependents = Dependency.Dependents or {}
            if not table.find(Dependency.Dependents, Control) then
                table.insert(Dependency.Dependents, Control)
            end

            if type(Control.SetVisibility) == "function" then
                Control:SetVisibility(Dependency.Value == true)
            end

            return Dependency
        end

        local function UpdateDependents(Toggle)
            for _, Control in ipairs(Toggle.Dependents or {}) do
                if type(Control.SetVisibility) == "function" then
                    Control:SetVisibility(Toggle.Value == true)
                end
            end
        end

