    local function GetDefaultTweenInfo()
        local Animation = Library.Animation
        local Key = tostring(Animation.Time) .. "|" .. tostring(Animation.Style) .. "|" .. tostring(Animation.Direction)
        if Key ~= DefaultTweenKey then
            DefaultTweenKey = Key
            DefaultTweenInfo = TweenInfo.new(Animation.Time, (Enum.EasingStyle[Animation.Style] :: any), (Enum.EasingDirection[Animation.Direction] :: any))
        end
        return DefaultTweenInfo
    end

    
    function Library:BuildFolderTree()
        if not self.Directory or self.Directory == "" then return end
        
        if not isfolder(self.Directory) then 
            makefolder(self.Directory)
        end

        for _, Folder in pairs(self.Folders) do 
            if not isfolder(self.Directory .. Folder) then 
                makefolder(self.Directory .. Folder)
            end
        end
    end

    function Library:SetFolder(Name)
        self.Directory = Name
        self:BuildFolderTree()
        
        if self.SaveManager then
            self.SaveManager.Folder = Name
        end
